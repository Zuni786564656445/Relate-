{
  "expo": {
    "name": "Relate",
    "slug": "relate-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FAF9F7"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourcompany.relate",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Relate uses the microphone for optional voice conversations with your AI advisor."
      }
    },
    "android": {
      "package": "com.yourcompany.relate",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF9F7"
      }
    },
    "plugins": []
  }
}
